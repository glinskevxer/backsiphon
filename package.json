{
  "name": "backsiphon",
  "version": "0.1.0",
  "private": true,
  "description": "Cross connection control register for a drinking water purveyor",
  "license": "UNLICENSED",
  "author": "glinskevxer <roym78109@gmail.com>",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "bin": {
    "backsiphon": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "commander": "13.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.17.16",
    "@vitest/coverage-v8": "1.6.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0",
    "vitest": "1.6.0"
  }
}
